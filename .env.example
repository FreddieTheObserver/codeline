# Runtime database. On Vercel use Supabase's Transaction pooler string (port 6543).
DATABASE_URL=postgres://codeline:codeline@localhost:54329/codeline
# Migrations and seeding from a laptop. On Supabase use the Session pooler string (port 5432).
MIGRATION_DATABASE_URL=postgres://codeline:codeline@localhost:54329/codeline

# Supabase Realtime. Leave empty locally; students then poll.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
